# Copy this file to .env (local) or add these as environment variables in your hoster.

# PostgreSQL connection string. Create a free database (e.g. Neon, Supabase, Railway)
# and paste its connection string here. The app uses Drizzle ORM.
DATABASE_URL=postgresql://user:password@host:5432/database

# No ADMIN_PASSWORD needed: the admin password is stored in the database
# (table admin_settings) and can be changed in /admin/security.
# First login password: Alyazen2026 — change it right after the first login.
